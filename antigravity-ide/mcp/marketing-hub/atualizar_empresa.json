{
  "name": "atualizar_empresa",
  "description": "Atualiza os dados de uma Empresa/Provedor existente.",
  "parameters": {
    "type": "object",
    "properties": {
      "id": {
        "type": "number",
        "description": "ID da empresa a ser atualizada"
      },
      "name": {
        "type": "string",
        "description": "Nome da empresa"
      },
      "legalName": {
        "type": "string",
        "description": "Razão social"
      },
      "billingCnpj": {
        "type": "string",
        "description": "CNPJ"
      },
      "contactName": {
        "type": "string",
        "description": "Nome do contato"
      },
      "phone": {
        "type": "string",
        "description": "Telefone"
      },
      "email": {
        "type": "string",
        "description": "E-mail"
      },
      "active": {
        "type": "boolean",
        "description": "Status ativo/inativo"
      }
    },
    "required": [
      "id"
    ]
  }
}
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Nome do parceiro comercial"
      },
      "legalName": {
        "type": "string",
        "description": "Razão social"
      },
      "document": {
        "type": "string",
        "description": "CNPJ ou CPF"
      },
      "contactName": {
        "type": "string",
        "description": "Nome do contato principal"
      },
      "phone": {
        "type": "string",
        "description": "Telefone de contato"
      },
      "email": {
        "type": "string",

# Runtime
NODE_ENV=production
PORT=8978
APP_ID=marketing-hub-easypanel
VITE_APP_ID=marketing-hub-easypanel
PUBLIC_APP_URL=https://marketing.seu-dominio.com

# PostgreSQL
DATABASE_URL=postgresql://usuario:***@host:5432/marketing_hub
# Alternativa aceita pelo servidor quando DATABASE_URL não está definida.
POSTGRES_URL=
# Use true quando o provedor exigir TLS. Para PostgreSQL interno do EasyPanel, normalmente false.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=8

# Sessões locais — gere um valor aleatório longo; nunca reutilize uma senha.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres

# Storage persistente. Monte um volume do EasyPanel neste caminho.
STORAGE_DIR=/data/storage

# Deploy seguro: executa migrations pendentes em cada inicialização.
RUN_MIGRATIONS=true
# Executa o bootstrap somente quando ADMIN_EMAIL e ADMIN_PASSWORD estiverem preenchidos.
RUN_ADMIN_BOOTSTRAP=true

# Bootstrap do primeiro administrador (execute `pnpm bootstrap:admin` uma vez).
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Troque-por-uma-senha-Forte-123
ADMIN_NAME=Administrador Trade HUB
# true somente quando quiser redefinir a senha do administrador existente.
ADMIN_RESET_PASSWORD=false
# Opcional: identificador de proprietário legado, não é necessário para o login local.
OWNER_OPEN_ID=

# Trello — opcional; a aplicação inicia sem estas chaves.
TRELLO_API_KEY=
TRELLO_TOKEN=
# Opcional: quadro padrão usado quando o usuário não configurou um quadro individual.
TRELLO_BOARD_ID=

# Notificações — opcional; sem webhook os eventos são registrados no log do servidor.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Login com Google — opcional; habilita o botão de acesso institucional no login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Integrações futuras/opcionais; não são necessárias para iniciar o núcleo.
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
# Proxy de IA (Forge) usado pelas procedures do namespace `ai`.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Fallback público de mapa (chave restrita por domínio) usado pelo componente de mapa no cliente.
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

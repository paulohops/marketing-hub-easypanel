# Runtime
NODE_ENV=production
PORT=3000
APP_ID=marketing-hub-easypanel
PUBLIC_APP_URL=https://marketing.seu-dominio.com

# PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/marketing_hub
# Use true quando o provedor exigir TLS. Para PostgreSQL interno do EasyPanel, normalmente false.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=8

# Sessões locais — gere um valor aleatório longo; nunca reutilize uma senha.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres

# Storage persistente. Monte um volume do EasyPanel neste caminho.
STORAGE_DIR=/data/storage

# Bootstrap do primeiro administrador (execute `pnpm bootstrap:admin` uma vez).
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Troque-por-uma-senha-Forte-123
ADMIN_NAME=Administrador Trade HUB
# true somente quando quiser redefinir a senha do administrador existente.
ADMIN_RESET_PASSWORD=false
# Opcional: identificador de proprietário legado, não é necessário para o login local.
OWNER_OPEN_ID=

# Trello — opcional; a aplicação inicia sem estas chaves.
TRELLO_API_KEY=
TRELLO_TOKEN=

# Notificações — opcional; sem webhook os eventos são registrados no log do servidor.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Integrações futuras/opcionais; não são necessárias para iniciar o núcleo.
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
